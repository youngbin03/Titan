# ===== REQUIRED =====
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ===== OPTIONAL (뉴스 수집 강화) =====
NEWSAPI_KEY=                    # https://newsapi.org (무료 100req/일)
NAVER_CLIENT_ID=                # https://developers.naver.com
NAVER_CLIENT_SECRET=
OPENAI_API_KEY=                 # 임베딩용 (없으면 규칙기반 매칭만 사용)
KALSHI_API_KEY=                 # https://kalshi.com (없으면 Polymarket만 사용)

# ===== EMAIL 발송 (선택) =====
RESEND_API_KEY=                 # https://resend.com (무료 100통/일)
EMAIL_FROM=signal@yourdomain.com
EMAIL_TO=your@email.com         # 쉼표 구분으로 여러 명 가능

# ===== 설정 =====
SIGNAL_SCORE_THRESHOLD=30       # 이 점수 이상 이벤트만 처리
URGENT_SIGNAL_THRESHOLD=70      # 이 점수 이상 즉시 발송
MAX_EVENTS_PER_EMAIL=5
MAX_ARTICLES_PER_EVENT=5
OUTPUT_DIR=./output             # 이메일 HTML 저장 경로 (데모용)

# ===== DB =====
DATABASE_URL=sqlite+aiosqlite:///./titan_signal.db
